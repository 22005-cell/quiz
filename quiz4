QUESTIONS = 10
ACHIEVED = 50
MERIT = 70
EXCELLENCE = 80


Score = 0
correct_answers = 0
incorrect_answers = 0
skipped_questions = 0
question_number = 0
answered = False


# ---------- FUNCTIONS ----------
def show_page(page):
    page1.pack_forget()
    page2.pack_forget()
    page3.pack_forget()
    
    page.pack()

def load_question():
    global question_number
    global answered
    answered = False
    
    current_question = quiz_questions[question_number]

    question_label.config(
        text=f"QUESTION {question_number + 1}: \n\n{current_question['question']}"
    )

    option_button_1.config(text=current_question["options"][0])
    option_button_2.config(text=current_question["options"][1])
    option_button_3.config(text=current_question["options"][2])
    option_button_4.config(text=current_question["options"][3])

def start_quiz():
    global question_number
    
    question_number = 0
    show_page(page2)
    load_question()
    
def check_answer(selected_answer):
    global Score
    global correct_answers
    global incorrect_answers
    global answered

    if answered:
        return

    answered = True

    current_question = quiz_questions[question_number]

    if selected_answer == current_question["answer"]:
        Score += 10
        correct_answers += 1
        messagebox.showinfo("Correct!", "Well done!")
    else:
        incorrect_answers += 1
        messagebox.showinfo(
            "Incorrect",
            f"The correct answer was:\n{current_question['answer']}"
        )
        
def next_question():
    global question_number

    question_number += 1

    if question_number < QUESTIONS:
        load_question()
    else:
        show_results()
        show_page(page3)
        
def show_results():
    if Score >= EXCELLENCE:
        results_text.config(text="YOU WIN!")
        feedback_text.config(text="Excellent work! You really know your HTML/CSS.")
        grade_text.config(text="EXCELLENCE")

    elif Score >= MERIT:
        results_text.config(text="YOU WIN!")
        feedback_text.config(text="Great job! You have a good understanding of HTML/CSS.")
        grade_text.config(text="MERIT")

    elif Score >= ACHIEVED:
        results_text.config(text="YOU WIN!")
        feedback_text.config(text="Good work! You achieved the required score.")
        grade_text.config(text="ACHIEVED")

    else:
        results_text.config(text="KEEP GOING!")
        feedback_text.config(text="Keep practising and try again!")
        grade_text.config(text="NOT ACHIEVED")

    score_text.config(text=f"SCORE: {Score}/100")
    
def play_again():
    global Score
    global correct_answers
    global incorrect_answers
    global skipped_questions
    global question_number
    global answered
    global quiz_questions

    Score = 0
    correct_answers = 0
    incorrect_answers = 0
    skipped_questions = 0
    question_number = 0
    answered = False

    quiz_questions = random.sample(questions, QUESTIONS)

    show_page(page2)
    load_question()

